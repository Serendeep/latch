{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-console": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/target/**",
    "**/gen/**",
    "**/generated/**",
    "playwright-report/**",
    "test-results/**"
  ]
}
