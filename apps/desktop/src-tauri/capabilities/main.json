  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The local main window may read vault state, create, unlock, and lock its vault.",
  "windows": ["main"],
  "permissions": [
    "allow-app-status",
    "allow-vault-create",
    "allow-vault-unlock",
    "allow-vault-lock"
  ]
}
