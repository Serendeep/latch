{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The local main window may manage its vault, scoped records, and one pending process request.",
  "windows": ["main"],
  "permissions": [
    "allow-app-status",
    "allow-vault-create",
    "allow-vault-unlock",
    "allow-vault-lock",
    "allow-project-choose-directory",
    "allow-projects-list",
    "allow-audit-events-list",
    "allow-project-create",
    "allow-project-rename",
    "allow-project-delete",
    "allow-environment-create",
    "allow-environment-delete",
    "allow-secrets-list",
    "allow-import-preview",
    "allow-import-commit",
    "allow-secret-create",
    "allow-secret-update",
    "allow-secret-delete",
    "allow-secret-reveal",
    "allow-secret-copy"
  ]
}
